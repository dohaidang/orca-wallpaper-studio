{
  "manifestVersion": 2,
  "id": "wallpaper-studio",
  "name": "Wallpaper Studio",
  "version": "0.2.0",
  "description": "Pick any image, crop and adjust it, and set it as the wallpaper of the ASCII · My Wallpaper themes.",
  "author": {
    "name": "dohaidang",
    "url": "https://github.com/dohaidang"
  },
  "repository": "https://github.com/dohaidang/orca-wallpaper-studio",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "wallpaper-studio",
        "title": "Wallpaper Studio",
        "icon": "layers",
        "entry": "panel/index.html"
      }
    ],
    "settings": [
      {
        "key": "themesDir",
        "title": "ASCII Themes folder",
        "type": "string",
        "default": "",
        "placeholder": "Folder of your copy of the ASCII Themes animated branch"
      },
      {
        "key": "python",
        "title": "Python with Pillow (optional)",
        "type": "string",
        "default": "",
        "placeholder": "Leave empty to find Python automatically"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "settings:own"
    }
  ]
}
